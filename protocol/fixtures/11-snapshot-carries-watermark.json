{
  "name": "基线快照带水位与分页标记",
  "why": "守住契约 §5.4:快照必须带 asOfSeq 与 hasMore;没有水位,快照生成期间到达的增量会被静默丢掉一段。",
  "bridge": { "s1": { "events": [] } },
  "relay": { "windowSize": 2 },
  "device": { "since": { "s1": 0 } },
  "steps": [
    { "op": "append", "sid": "s1", "itemId": "m1", "text": "一" },
    { "op": "append", "sid": "s1", "itemId": "m2", "text": "二" },
    { "op": "append", "sid": "s1", "itemId": "m3", "text": "三" },
    { "op": "relayEvictAll" },
    { "op": "bridgeTrim", "sid": "s1", "upto": 2 },
    { "op": "hello" },
    { "op": "ack", "sid": "s1" }
  ],
  "expect": {
    "recovery": {
      "s1": { "source": "bridge", "outcome": "snapshot", "reason": "window-missed", "asOfSeq": 3, "hasMore": false }
    },
    "items": { "s1": ["m1", "m2", "m3"] },
    "itemCount": { "s1": 3 },
    "deviceCursor": { "s1": 3 },
    "converged": true
  }
}
