{
  "name": "审批接管的判定表",
  "why": "守住契约 §6.2:三档 × 设备状态的 claim 判定必须可机械判定;并列时必须确定(最近交互 → 最早配对 → id 升序),否则『哪台手机接管』会随迭代顺序漂移。",
  "bridge": { "s1": { "events": [] } },
  "relay": { "windowSize": 10 },
  "device": { "since": { "s1": 0 } },
  "steps": [
    { "op": "takeover", "mode": "never", "sid": "s1", "devices": [
      { "id": "d1", "online": true, "foreground": true, "subscribed": ["s1"], "pairedAt": 1 }
    ] },
    { "op": "takeover", "mode": "foreground", "sid": "s1", "devices": [
      { "id": "d1", "online": true, "foreground": false, "subscribed": ["s1"], "pairedAt": 1 }
    ] },
    { "op": "takeover", "mode": "foreground", "sid": "s1", "devices": [
      { "id": "d1", "online": true, "foreground": true, "subscribed": ["s2"], "pairedAt": 1 }
    ] },
    { "op": "takeover", "mode": "foreground", "sid": "s1", "devices": [
      { "id": "d1", "online": true, "foreground": true, "subscribed": ["s1"], "pairedAt": 5 },
      { "id": "d2", "online": true, "foreground": true, "subscribed": ["s1"], "pairedAt": 2 }
    ] },
    { "op": "takeover", "mode": "always", "sid": "s1", "devices": [
      { "id": "d1", "online": false, "foreground": false, "subscribed": [], "pairedAt": 1 }
    ] },
    { "op": "takeover", "mode": "always", "sid": "s1", "devices": [
      { "id": "d1", "online": true, "foreground": false, "subscribed": [], "pairedAt": 1, "lastInteractedAt": { "s1": 10 } },
      { "id": "d2", "online": true, "foreground": true, "subscribed": ["s1"], "pairedAt": 2, "lastInteractedAt": { "s1": 20 } }
    ] }
  ],
  "expect": {
    "takeover": [
      { "claim": false, "deviceId": null, "reason": "mode-never" },
      { "claim": false, "deviceId": null, "reason": "no-foreground-subscriber" },
      { "claim": false, "deviceId": null, "reason": "no-foreground-subscriber" },
      { "claim": true, "deviceId": "d2", "reason": "foreground-claimed" },
      { "claim": false, "deviceId": null, "reason": "no-online-device" },
      { "claim": true, "deviceId": "d2", "reason": "always-claimed" }
    ]
  }
}
