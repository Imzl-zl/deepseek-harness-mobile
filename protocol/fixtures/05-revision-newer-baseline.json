    { "op": "append", "sid": "s1", "itemId": "m1", "text": "一" },
    { "op": "append", "sid": "s1", "itemId": "m2", "text": "二" },
    { "op": "hello" },
    { "op": "ack", "sid": "s1" }
  ],
  "expect": {
    "recovery": { "s1": { "source": "bridge", "outcome": "snapshot", "reason": "revision-newer" } },
    "items": { "s1": ["m1", "m2"] },
    "converged": true
  }
}
