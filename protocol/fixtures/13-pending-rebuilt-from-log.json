{
  "name": "待审批集合可从持久日志重建",
  "why": "守住契约 §6.3 与 I4:ask 与 outcome 成对落盘,悬空即『有 ask、无 outcome』;桥接重启后从日志重建,不依赖进程内存。",
  "bridge": { "s1": { "events": [] } },
  "relay": { "windowSize": 10 },
