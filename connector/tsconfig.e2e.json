{
  // 跨工程 e2e 的**单独**配置:它用 `.ts` 后缀导入 `relay/` 的源码,而那只在
  // `allowImportingTsExtensions` 下合法。主 `tsconfig.json` 有意不开这个开关
  // (开了之后 `src/` 里也能写 `.ts` 后缀,而构建走 tsdown 不认那个后缀),
  // 所以那条用例在主配置里被 exclude,由这里检查。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "tests", "../relay/src", "tsdown.config.ts"],
  "exclude": []
}
